NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-08
# Local dev: http://localhost:3333 — Production: https://kunalkeshan.sanity.studio
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
NODE_ENV="development"
SITE_URL="http://localhost:3000"

# Vercel environment variables (automatically provided by Vercel)
# VERCEL_DEPLOYMENT_ID=        # Unique deployment ID (used for PWA cache versioning)
# VERCEL_GIT_COMMIT_SHA=       # Git commit SHA (used for PWA cache versioning)

# Sanity Webhook Secret (required for on-demand revalidation)
# Generate a strong secret and add the same value to your Sanity webhook configuration
SANITY_WEBHOOK_SECRET=

# Sanity Viewer-role read token (required for Live Content API / draft-mode
# preview via the Presentation Tool). Create at sanity.io/manage → project →
# API → Tokens → Add API token, Viewer permission. Never prefix with
# NEXT_PUBLIC_ — next-sanity's defineLive scopes this to authenticated
# draft-mode sessions only, it is not a public/bundled secret.
SANITY_API_READ_TOKEN=

# Efferd Pro registry token (required to install @efferd shadcn components, see components.json "registries")
# Get yours from https://efferd.com/account
EFFERD_REGISTRY_TOKEN=

# Nodemailer (Gmail SMTP) — sends the /contact form notification email.
# NODEMAILER_EMAIL is the sending Gmail account; NODEMAILER_PASSWORD is a
# Google Account App Password (requires 2FA on that account), NOT the normal
# login password. Generate one at https://myaccount.google.com/apppasswords
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=

# Cloudflare Turnstile — bot protection for the /contact form.
# Optional: while unset, the widget is hidden and server-side verification is
# skipped entirely, so the form still works with no bot protection at all.
# Create a widget at https://dash.cloudflare.com (Turnstile) once the domain
# is finalized, then set both keys below.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
