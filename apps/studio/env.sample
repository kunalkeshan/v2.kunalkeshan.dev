SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=
SANITY_STUDIO_TITLE="Kunal Keshan"
SANITY_STUDIO_API_VERSION=2026-01-08
# Generated on first `sanity deploy` — set this so later deploys target the same Studio app
SANITY_STUDIO_APP_ID=

# Presentation Tool preview origin — the web app URL the Studio's Presentation
# tab loads in its iframe. This is the local-dev default (http://localhost:3000);
# `sanity build`/`sanity deploy` automatically load apps/studio/.env.production
# instead (gitignored, not sampled here since it holds a single public URL, not
# a secret — see docs/runbooks/sanity-workflow.md for its exact contents).
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3000
